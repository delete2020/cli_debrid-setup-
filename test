# --- Main Menu ---

show_main_menu() {
  while true; do
    header "Debrid Media Stack Manager v2.0"
    echo "1) Install New Setup (CLI Mode)"
    echo "2) Install New Setup (DMB Mode)"
    echo "3) Update/Reconfigure Existing"
    echo "4) Repair Installation"
    echo "5) Backup System"
    echo "6) Restore System"
    echo "7) Uninstall System"
    echo "8) Documentation"
    echo "9) Exit"
    
    read -p "Select option: " OPT
    case $OPT in
      1) 
        INSTALL_TYPE="cli"
        setup_directories
        get_rd_api_key
        select_components
        setup_firewall
        save_state
        generate_configs
        generate_docker_compose
        deploy_stack
        test_zurg_connection
        ;;
      2)
        INSTALL_TYPE="dmb"
        setup_directories
        get_rd_api_key
        read -p "Deploy Plex? (y/N): " PLEX_YN
        if [[ "${PLEX_YN,,}" == "y" ]]; then
          DEPLOY_PLEX=true
          read -p "Plex Claim Token: " PLEX_CLAIM
        fi
        save_state
        generate_dmb_compose
        deploy_stack
        ;;
      3) update_existing_setup ;;
      4) repair_installation ;;
      5) backup_system ;;
      6) restore_system ;;
      7) uninstall_system ;;
      8) view_help ;;
      9) exit 0 ;;
      *) warning "Invalid option" ;;
    esac
  done
}

